# Root environment file template for this monorepo.
# Copy this file to `.env` at the project root and adjust values.
#
# Why root only?
# - apps/license-server loads root `.env`
# - apps/admin-web (Vite) loads root `.env` via envDir
# - docker compose commands also read root `.env`
#
# Quick start:
#   cp .env.sample .env

###############################################################################
# 1) Backend (license-server) - REQUIRED for local app behavior
###############################################################################

# [Required for bootstrap/migration]
# PostgreSQL connection string used by Prisma and runtime DB adapter.
# Local dev with docker-compose.dev.yml usually uses port 5532.
DATABASE_URL="postgresql://license:license@localhost:5532/license_server?schema=public"

# [Recommended]
# Seed/login admin email. Used by db bootstrap seed and admin login flow.
ADMIN_EMAIL="admin@example.com"

# [Recommended]
# Seed/login admin password. Change this to a strong value in non-local environments.
ADMIN_PASSWORD="change_me_password"

# [Required for admin login API]
# JWT signing secret for /admin/login and bearer token verification.
# Must be random and long in staging/production.
ADMIN_JWT_SECRET="change_me_jwt_secret"

# [Optional]
# JWT expiration value (e.g. 12h, 7d, 3600s). Default is 12h.
ADMIN_JWT_EXPIRES_IN="12h"

###############################################################################
# 2) Backend runtime tuning - OPTIONAL
###############################################################################

# [Optional] Backend HTTP port. Default is 3000.
# PORT="3000"

# [Optional] NODE_ENV is already set by npm scripts where needed.
# You can set explicitly for manual runs.
# NODE_ENV="development"

###############################################################################
# 3) Frontend (admin-web / Vite) - OPTIONAL for local dev
###############################################################################

# [Optional]
# API target used by Vite dev proxy.
# Default: http://localhost:3000
# VITE_BACKEND_URL="http://localhost:3000"

# [Optional]
# Base path for BrowserRouter and Vite base config.
# Keep this in sync with reverse proxy path if you host under subpath.
# Default: /license-console-k9/
# VITE_APP_BASE_PATH="/license-console-k9/"

###############################################################################
# 4) Local helper script tuning (scripts/dev-local.sh) - OPTIONAL
###############################################################################

# [Optional] Frontend preferred port (script auto-fallbacks if occupied).
# FRONTEND_PORT="5174"

# [Optional] Max retries when scanning for available ports.
# PORT_SCAN_MAX="20"

# [Optional] Set to 1 to skip bootstrap step in `pnpm dev:local`.
# LOCAL_DEV_SKIP_BOOTSTRAP="0"

###############################################################################
# 5) Docker compose production profile - OPTIONAL (only when used)
###############################################################################

# Image namespace/tag controls (docker-compose.prod.yml)
# GHCR_NAMESPACE="skkim7821"
# BACKEND_IMAGE_TAG="main"
# ADMIN_WEB_IMAGE_TAG="main"

# Nginx/HTTPS runtime vars for admin-web container
# SERVER_NAME="example.com"
# ENABLE_HTTPS="true"
# SSL_CERT_PATH="/etc/letsencrypt/live/example.com/fullchain.pem"
# SSL_KEY_PATH="/etc/letsencrypt/live/example.com/privkey.pem"
