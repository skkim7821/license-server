// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  code          String    @id
  name          String
  maxDevices    Int
  defaultPeriod Int
  licenses      License[]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  licenses  License[]
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(super_admin)
  status       AdminStatus @default(active)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model License {
  id          String         @id @default(cuid())
  licenseKey  String         @unique
  email       String
  userId      String?
  productCode String
  expiresAt   DateTime
  status      LicenseStatus  @default(active)
  blockReason LicenseBlockReason?
  blockedAt   DateTime?
  blockedBy   String?
  blockNote   String?
  unblockedAt DateTime?
  unblockedBy String?
  unblockedNote String?
  maxDevices  Int
  user        User?          @relation(fields: [userId], references: [id])
  product     Product        @relation(fields: [productCode], references: [code])
  devices     LicenseDevice[]

  @@unique([email, productCode])
}

model LicenseDevice {
  id          String   @id @default(cuid())
  licenseId   String
  ipAddr      String
  createdAt   DateTime @default(now())
  license     License  @relation(fields: [licenseId], references: [id])

  @@unique([licenseId, ipAddr])
}

enum LicenseStatus {
  active
  suspended
  revoked
  expired
}

enum LicenseBlockReason {
  abuse
  manual_review
  security_risk
  server_impact
  billing_issue
  other
}

enum AdminRole {
  super_admin
  operator
}

enum AdminStatus {
  active
  disabled
}
