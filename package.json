{
  "name": "license-server-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter license-server dev",
    "build": "pnpm --filter license-server build",
    "start": "pnpm --filter license-server start",
    "start:prod": "pnpm --filter license-server start:prod",
    "test": "pnpm --filter license-server test",
    "prisma": "pnpm --filter license-server prisma",
    "db:bootstrap": "pnpm --filter license-server db:bootstrap",
    "db:bootstrap:prod": "pnpm --filter license-server db:bootstrap:prod",
    "db:bootstrap:no-seed": "pnpm --filter license-server db:bootstrap:no-seed",
    "db:reset": "pnpm --filter license-server db:reset",
    "seed:dev": "pnpm --filter license-server seed:dev",
    "seed:prod": "pnpm --filter license-server seed:prod",
    "check:all": "pnpm --filter license-server check:all",
    "frontend:dev": "pnpm --filter admin-web dev",
    "frontend:build": "pnpm --filter admin-web build",
    "dev:local": "bash ./scripts/dev-local.sh",
    "docker:up": "docker compose -f deploy/docker/docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose -f deploy/docker/docker-compose.dev.yml down",
    "docker:ps": "docker compose -f deploy/docker/docker-compose.dev.yml ps",
    "docker:logs": "docker compose -f deploy/docker/docker-compose.dev.yml logs -f --tail=200",
    "docker:up:prod": "docker compose -f deploy/docker/docker-compose.prod.yml up -d",
    "docker:down:prod": "docker compose -f deploy/docker/docker-compose.prod.yml down"
  }
}
